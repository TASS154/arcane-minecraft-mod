{
  "category": "modifier",
  "behavior": {
    "handler": "arcane:domain"
  },
  "parameters": {
    "seconds": {
      "type": "float",
      "default": 30.0,
      "min": 5.0,
      "max": 60.0
    },
    "interval": {
      "type": "float",
      "default": 1.0,
      "min": 0.5,
      "max": 5.0
    }
  },
  "modifier_scope": {
    "target": "delivery",
    "kind": "form",
    "mutate": {
      "zone_seconds": {
        "op": "put",
        "value": 30.0,
        "param": "seconds"
      },
      "zone_interval": {
        "op": "put",
        "value": 1.0,
        "param": "interval"
      },
      "domain": {
        "op": "put",
        "value": 1.0
      }
    }
  },
  "cost": {
    "mana": 4
  },
  "tier": 3,
  "families": [
    "arcane"
  ]
}
